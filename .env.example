DOMAIN=goexploria.test

APP_NAME=GoExploria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://goexploria.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goexploria
DB_USERNAME=root
DB_PASSWORD=

# La base importée ne contient ni table "sessions" ni table "cache" :
# on reste sur les pilotes fichier (les défauts Laravel 11 sont "database").
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@goexploria.com"
MAIL_FROM_NAME="${APP_NAME}"

# Chemin du binaire wkhtmltopdf utilisé pour les PDF de rendez-vous.
WKHTMLTOPDF_BINARY=/usr/local/bin/wkhtmltopdf

INVISIBLE_RECAPTCHA_SITEKEY=
INVISIBLE_RECAPTCHA_SECRETKEY=
